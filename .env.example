# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/library_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=your-very-long-secret-key-at-least-256-bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mail (Gmail SMTP example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 redirect (frontend URL)
OAUTH2_REDIRECT_URL=http://localhost:3000/oauth2/callback
